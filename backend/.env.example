# AgentForge backend — копия в backend/.env при локальном запуске.
# В Docker используются переменные из корневого .env.

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Локальная разработка без Docker (PostgreSQL должен быть запущен локально):
DATABASE_URL=postgresql+psycopg://agentos:agentos_secret@localhost:5432/agentos
REDIS_URL=redis://localhost:6379/0

# Для тестов можно использовать SQLite:
# DATABASE_URL=sqlite+pysqlite:///./dev.db

# LLM (опционально; без ключа SystemAgent работает в детерминированном режиме)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEFAULT_AGENT_MODEL=gpt-4o-mini
DEFAULT_AGENT_TEMPERATURE=0.3

# Оркестратор
ORCHESTRATOR_WORKERS=4
