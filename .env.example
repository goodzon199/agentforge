# ===== AgentForge / docker-compose =====
# Копия в backend/.env и frontend/.env.local при необходимости.

# --- Postgres ---
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos_secret
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
DATABASE_URL=postgresql+psycopg://agentos:agentos_secret@db:5432/agentos
REDIS_URL=redis://redis:6379/0
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM (OpenAI или совместимый) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
DEFAULT_AGENT_MODEL=gpt-4o-mini
DEFAULT_AGENT_TEMPERATURE=0.3

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000
