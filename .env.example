# ===== AgentForge / docker-compose =====
# Копия в backend/.env и frontend/.env.local при необходимости.

# --- Postgres ---
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos_secret
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend ---
DATABASE_URL=postgresql+psycopg://agentos:agentos_secret@db:5432/agentos
REDIS_URL=redis://redis:6379/0
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM (OpenAI-совместимый API) ---
# По умолчанию — локальная Ollama (сервис в docker-compose).
# Для внешнего провайдера: OPENAI_BASE_URL=https://api.openai.com/v1, OPENAI_MODEL=gpt-4o-mini, OPENAI_API_KEY=sk-...
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_MODEL=qwen2.5:3b
DEFAULT_AGENT_MODEL=qwen2.5:3b
DEFAULT_AGENT_TEMPERATURE=0.3
# Модель, которую docker-compose скачает в Ollama при первом запуске:
OLLAMA_MODEL=qwen2.5:3b

# Модель эмбеддингов для векторного поиска по Knowledge Base:
EMBEDDING_MODEL=nomic-embed-text

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
FRONTEND_PORT=3000

# --- SMTP / Email ---
# Демо: MailHog (SMTP на порту 1025, UI на http://localhost:8025).
# Для боевого окружения укажите реальный SMTP-хост.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agentforge@agentos.local
EMAIL_DEFAULT_TO=demo@agentos.local
