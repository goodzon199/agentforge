# ===== AgentOS (микросервисный стек, docker-compose.yml) =====
# Единственная схема запуска: core + autoparts + beauty + frontend.
# Скопируйте в .env при необходимости переопределить значения по умолчанию.

# --- Postgres (две отдельные БД) ---
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos_secret
POSTGRES_CORE_PORT=5433
POSTGRES_AUTOPARTS_PORT=5434

# --- Redis ---
REDIS_PORT=6379

# --- Порты сервисов ---
CORE_API_PORT=8011
AUTOPARTS_API_PORT=8012
BEAUTY_API_PORT=8013
FRONTEND_PORT=3000

# --- Внутренний контракт core <-> packs ---
# Общий токен для /internal/* вызовов между сервисами (смените в проде).
INTERNAL_API_TOKEN=dev-internal-token-change-me

# --- LLM (OpenAI-совместимый API) ---
# По умолчанию — локальная Ollama из compose-стека.
# Для облака: OPENAI_BASE_URL=https://api.openai.com/v1, OPENAI_MODEL=gpt-4o-mini, OPENAI_API_KEY=sk-...
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_MODEL=qwen2.5:3b
DEFAULT_AGENT_MODEL=qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b

# --- SMTP / Email ---
# Демо: MailHog (SMTP порт 1025, UI порт http://localhost:8025).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=agentforge@agentos.local
EMAIL_DEFAULT_TO=demo@agentos.local

# --- Auth (JWT) ---
# Обязательно замените JWT_SECRET для продакшена (>= 32 случайных символа).
JWT_SECRET=dev-only-agentforge-jwt-secret-change-me-9f3a1c
JWT_EXPIRE_MINUTES=10080
SEED_ADMIN_EMAIL=admin@agentos.local
SEED_ADMIN_PASSWORD=admin123

# --- Прочее ---
ENVIRONMENT=development
